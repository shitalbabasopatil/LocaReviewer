# ==========================================
# LocaReviewer Environment Configuration
# ==========================================

# Google AI API Key for accessing Gemini Models
# You can generate a free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Backend Environment Toggle
# 0 = Use Google AI Studio (Default for local development)
# 1 = Use Vertex AI (Enterprise / Google Cloud deployment)
GOOGLE_GENAI_USE_VERTEXAI=0

# ==========================================
# Vertex AI Specific Configuration
# (Uncomment and populate ONLY if GOOGLE_GENAI_USE_VERTEXAI=1)
# ==========================================
# VERTEX_PROJECT_ID=your_google_cloud_project_id
# VERTEX_LOCATION=us-central1
